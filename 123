<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WHK班主任：2026退役生终极模拟</title>
    <style>
        :root {
            --bg: #05070a;
            --panel: #10141d;
            --accent: #00d2ff;
            --accent-dim: rgba(0, 210, 255, 0.3);
            --text: #e0e6ed;
            --text-dark: #64748b;
            --danger: #ff4d4d;
            --success: #2ecc71;
            --warning: #f1c40f;
            --border: #1e293b;
            --card-bg: #161c28;
        }

        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', 'PingFang SC', sans-serif;
            cursor: default;
        }

        body {
            background: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* 统一滚动条 */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 10px;
        }

        /* 顶部面板 */
        header {
            height: 60px;
            background: var(--panel);
            border-bottom: 2px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.2);
            z-index: 1000;
        }

        .stat-group {
            display: flex;
            gap: 25px;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: bold;
            font-size: 0.95rem;
        }

        .stat-item b {
            color: var(--accent);
            text-shadow: 0 0 10px var(--accent-dim);
        }

        /* 主体布局 */
        .layout {
            display: grid;
            grid-template-columns: 350px 1fr 320px;
            flex: 1;
            overflow: hidden;
            gap: 2px;
            background: var(--border);
        }

        .side-panel {
            background: var(--panel);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* 导航切换 */
        .nav-tabs {
            display: flex;
            background: #0a0e14;
            border-bottom: 1px solid var(--border);
        }

        .tab {
            flex: 1;
            padding: 15px;
            text-align: center;
            color: var(--text-dark);
            cursor: pointer;
            font-weight: bold;
            font-size: 0.85rem;
        }

        .tab.active {
            color: var(--accent);
            background: rgba(0, 210, 255, 0.05);
            border-bottom: 2px solid var(--accent);
        }

        /* 教学指令卡片 */
        .scroll-v {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .action-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 12px;
            position: relative;
            transition: 0.2s;
        }

        .action-card:hover:not(.locked) {
            border-color: var(--accent);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            cursor: pointer;
        }

        .action-card.locked {
            opacity: 0.4;
            filter: grayscale(1);
        }

        .action-title {
            font-size: 0.95rem;
            font-weight: bold;
            margin-bottom: 4px;
            display: block;
        }

        .action-desc {
            font-size: 0.75rem;
            color: var(--text-dark);
            line-height: 1.4;
        }

        .action-cost {
            position: absolute;
            right: 12px;
            top: 12px;
            font-size: 0.7rem;
            color: var(--warning);
            font-weight: 800;
        }

        /* 学生网格 */
        .classroom {
            padding: 25px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
            align-content: start;
        }

        .stu-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 20px;
            position: relative;
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .stu-card:hover {
            border-color: var(--accent);
        }

        .stu-card.sick {
            border-color: var(--danger);
            animation: pulse 2s infinite;
        }

        .stu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .stu-name {
            font-size: 1.2rem;
            font-weight: 800;
            background: linear-gradient(to right, #fff, #00d2ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .radar-box {
            font-size: 0.65rem;
            color: var(--warning);
            border: 1px dashed var(--warning);
            padding: 4px 8px;
            border-radius: 6px;
            margin-bottom: 12px;
        }

        .sub-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 15px;
        }

        .sub-box {
            background: rgba(0, 0, 0, 0.3);
            padding: 8px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sub-n {
            font-size: 0.6rem;
            color: var(--text-dark);
            margin-bottom: 4px;
            display: block;
        }

        .sub-v {
            font-size: 1rem;
            font-weight: bold;
            font-family: 'Consolas';
        }

        .bar-group {
            margin-bottom: 8px;
        }

        .bar-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            margin-bottom: 4px;
            font-weight: bold;
        }

        .bar-outer {
            height: 6px;
            background: #000;
            border-radius: 3px;
            overflow: hidden;
        }

        .bar-inner {
            height: 100%;
            width: 0;
            transition: width 0.6s cubic-bezier(0.1, 0.9, 0.2, 1);
        }

        /* 商店物品栏 */
        .item-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .item-box {
            background: #0f172a;
            border: 1px solid var(--border);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
        }

        .item-box img {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 5px;
        }

        /* 模态框 */
        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            z-index: 2000;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal {
            background: var(--panel);
            border: 1px solid var(--accent);
            border-radius: 24px;
            width: 90%;
            max-width: 700px;
            padding: 40px;
        }

        .name-input-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 25px 0;
        }

        .name-input-row input {
            background: #05070a;
            border: 1px solid var(--border);
            color: #fff;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            text-align: center;
        }

        .name-input-row input:focus {
            border-color: var(--accent);
        }

        .btn-full {
            width: 100%;
            padding: 15px;
            background: var(--accent);
            color: #000;
            border: none;
            border-radius: 12px;
            font-weight: 900;
            font-size: 1.1rem;
            cursor: pointer;
        }

        .log-list {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column-reverse;
            gap: 8px;
        }

        .log-card {
            padding: 10px;
            border-left: 2px solid var(--border);
            font-size: 0.8rem;
            background: rgba(255, 255, 255, 0.02);
        }

        .log-card.event {
            border-left-color: var(--warning);
            color: var(--warning);
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 77, 77, 0.4);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(255, 77, 77, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 77, 77, 0);
            }
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>

<body>

    <header id="header" class="hidden">
        <div class="stat-group">
            <div class="stat-item">📅 <span id="ui-date">2025/09 W1</span></div>
            <div class="stat-item">💰 经费 <b id="ui-money">0</b></div>
            <div class="stat-item">⚡ AP <b id="ui-ap">3/3</b></div>
        </div>
        <div class="stat-group">
            <div class="stat-item">🏅 名望 <b id="ui-prestige">0</b></div>
            <button onclick="Game.nextTurn()"
                style="background:var(--accent); color:#000; border:none; padding:8px 20px; border-radius:20px; font-weight:900; cursor:pointer;">结束本周</button>
        </div>
    </header>

    <div id="start-screen" class="overlay">
        <div class="modal" style="text-align: center;">
            <h1 style="color:var(--accent); margin:0; font-size: 2.5rem;">天命：whk模拟器</h1>
            <p style="color:var(--text-dark);">退役生集训开始。输入姓名，系统将计算隐藏 MD5 属性。</p>
            <div class="name-input-row">
                <input type="text" id="n-0" placeholder="Double10">
                <input type="text" id="n-1" placeholder="Sparktasia">
                <input type="text" id="n-2" placeholder="paper_">
                <input type="text" id="n-3" placeholder="GoldSpade">
                <input type="text" id="n-4" placeholder="xxxxxzy">
                <input type="text" id="n-5" placeholder="Communist">
            </div>
            <button class="btn-full" onclick="Game.init()">注入代码，开启模拟</button>
        </div>
    </div>

    <div class="layout hidden" id="game-ui">
        <aside class="side-panel">
            <div class="nav-tabs">
                <div class="tab active" onclick="UI.switchTab('cmds')">教学指令</div>
                <div class="tab" onclick="UI.switchTab('skills')">技能树</div>
                <div class="tab" onclick="UI.switchTab('shop')">黑市补给</div>
            </div>

            <div id="panel-cmds" class="scroll-v">
                <div id="teaching-list"></div>
                <div style="margin:20px 0 10px; font-size:0.7rem; color:var(--accent); font-weight:bold;">班级福利</div>
                <div id="welfare-list"></div>
            </div>

            <div id="panel-skills" class="scroll-v hidden">
                <p style="font-size:0.75rem; color:var(--text-dark); margin-bottom:20px;">消耗<b>名望</b>提升你的教师职等：</p>
                <div id="skill-list"></div>
            </div>

            <div id="panel-shop" class="scroll-v hidden">
                <p style="font-size:0.75rem; color:var(--text-dark); margin-bottom:20px;">利用<b>班费</b>采购各类增强物资：</p>
                <div id="item-shop" class="item-grid"></div>
            </div>
        </aside>

        <main class="side-panel" style="background: var(--bg);">
            <div class="classroom" id="classroom-grid"></div>
        </main>

        <aside class="side-panel" style="border-left: 1px solid var(--border);">
            <div
                style="height:150px; background:rgba(0,210,255,0.05); padding:15px; border-bottom:1px solid var(--border);">
                <div style="font-size:0.7rem; color:var(--accent); font-weight:bold; margin-bottom:8px;">📡 考点风向标</div>
                <div id="weather-report" style="font-size:0.85rem; line-height:1.4;"></div>
            </div>
            <div class="log-list" id="log-list"></div>
        </aside>
    </div>

    <div id="modal-msg" class="overlay hidden">
        <div class="modal">
            <h2 id="msg-title" style="color:var(--accent);">月考结算</h2>
            <div id="msg-body"
                style="margin:20px 0; font-size:0.9rem; line-height:1.6; max-height:300px; overflow-y:auto;"></div>
            <button class="btn-full" onclick="UI.closeModal('modal-msg')">确认回执</button>
        </div>
    </div>

    <script>
        /** ================== 核心：MD5 模拟与天命生成 ================== **/
        const Destiny = {
            // 简易 Hash 算法生成固定随机种子
            getHash(str) {
                let h = 0;
                for (let i = 0; i < str.length; i++) h = ((h << 5) - h) + str.charCodeAt(i) | 0;
                return Math.abs(h);
            },
            generate(name) {
                const h = this.getHash(name);
                const traits = [
                    { n: "数学直觉", d: "数学/物理潜力突破天际", mod: { mat: 1.5, phy: 1.4, eng: 0.8 } },
                    { n: "语言天才", d: "语文/英语学习效率翻倍", mod: { chi: 2.0, eng: 2.0, mat: 0.8 } },
                    { n: "六边形战士", d: "全学科平衡，压力上限极高", mod: { all: 1.2, stress_cap: 1.5 } },
                    { n: "极致爆发", d: "考试时概率获得 +50 额外分", mod: { luck: 0.4 } },
                    { n: "抗压怪才", d: "压力增长减半，永不厌学", mod: { stress_gain: 0.5, no_burnout: true } },
                    { n: "深度睡眠", d: "每周自动恢复大量压力", mod: { recover: 3.0 } }
                ];
                // 核心潜力：利用 Hash 每一位分配属性潜力
                const potential = {
                    logic: (h % 10) + 10,   // 数理逻辑
                    memory: ((h / 10) % 10) + 10, // 记忆力
                    mental: ((h / 100) % 10) + 10 // 心理素质
                };
                return { trait: traits[h % traits.length], potential };
            }
        };

        /** ================== 游戏数据 ================== **/
        const DATA = {
            ACTIONS: {
                teaching: [
                    { id: 'study', n: '自主刷题', d: '全科微幅提升', ap: 1, money: 0 },
                    { id: 'lesson', n: '专题突击', d: '指定学科大幅提升', ap: 1, money: 800 },
                    { id: 'mock', n: '全真模拟', d: '提升应试技巧', ap: 2, money: 500 }
                ],
                welfare: [
                    { id: 'hotpot', n: '包场火锅', d: '全班压力清零', ap: 2, money: 2500 },
                    { id: 'movie', n: '放映晚会', d: '提升自信，缓解压力', ap: 1, money: 1000 }
                ]
            },
            ITEMS: [
                { id: 'i1', n: '五三同步', d: '全班学习效率 +10%', cost: 3000, type: 'passive' },
                { id: 'i2', n: '红牛成箱', d: '下周额外获得 1 点 AP', cost: 1500, type: 'active' },
                { id: 'i3', n: '人体工学椅', d: '压力增长率永久 -20%', cost: 6000, type: 'passive' }
            ],
            SKILLS: [
                { id: 's1', n: '特级教师职称', d: '每周经费 +500', cost: 15 },
                { id: 's2', n: '教育学专家', d: '解锁“单独谈心”不消耗 AP', cost: 30 },
                { id: 's3', n: '资源整合', d: '所有商店物品价格 -30%', cost: 50 }
            ]
        };

        /** ================== 游戏核心 ================== **/
        let State = {
            money: 0, ap: 3, maxAp: 3, week: 1, month: 9, year: 2025, prestige: 0,
            students: [], items: [], skills: [], inventory: []
        };

        const Game = {
            init() {
                const names = [];
                for (let i = 0; i < 6; i++) names.push(document.getElementById(`n-${i}`).value.trim() || document.getElementById(`n-${i}`).placeholder);

                State.money = 5000;
                State.students = names.map(name => {
                    const des = Destiny.generate(name);
                    return {
                        name, des, stress: 10, burnout: false, confidence: 50,
                        mastery: { chi: 40, mat: 60, eng: 40, phy: 50, che: 45, bio: 45 }
                    };
                });

                document.getElementById('start-screen').classList.add('hidden');
                document.getElementById('header').classList.remove('hidden');
                document.getElementById('game-ui').classList.remove('hidden');

                UI.initTemplates();
                this.updateUI();
                this.log("🚩 战役开始。名字中的 MD5 代码已注入学生基因。");
            },

            nextTurn() {
                if (State.month === 6 && State.year === 2026) return this.gaokao();

                State.week++;
                if (State.week > 4) {
                    State.week = 1; State.month++;
                    if (State.month > 12) { State.month = 1; State.year++; }
                    this.runMonthExam();
                }

                // 状态更新
                State.students.forEach(s => {
                    // 协同加成：数学好会增加理化学习效率
                    const logicBonus = s.mastery.mat / 200;

                    // 压力计算
                    if (s.stress > 95 && !s.des.trait.mod.no_burnout) s.burnout = true;
                    let recover = 5 * (s.des.trait.mod.recover || 1);
                    s.stress = Math.max(0, s.stress - recover);

                    if (s.burnout) {
                        s.confidence = Math.max(0, s.confidence - 10);
                        this.log(`⚠️ ${s.name} 心态崩溃，本周无法学习！`, "event");
                    }
                });

                // 资源回复
                State.ap = State.maxAp;
                if (State.inventory.includes('i2')) { State.ap += 1; State.inventory = State.inventory.filter(x => x !== 'i2'); }

                let income = 1200 + (State.skills.includes('s1') ? 500 : 0);
                State.money += income;

                this.updateUI();
            },

            doAction(id, target = null) {
                const act = [...DATA.ACTIONS.teaching, ...DATA.ACTIONS.welfare].find(a => a.id === id);
                if (State.ap < act.ap) return alert("AP 不足！");
                if (State.money < act.money) return alert("经费不足！");

                State.ap -= act.ap;
                State.money -= act.money;

                let eff = 1.0;
                if (State.items.includes('i1')) eff += 0.1;

                if (id === 'study') {
                    State.students.forEach(s => {
                        if (s.burnout) return;
                        const gain = 2.5 * eff * (s.des.trait.mod.all || 1);
                        Object.keys(s.mastery).forEach(k => {
                            let kGain = gain * (s.des.trait.mod[k] || 1);
                            // 逻辑协同
                            if (k === 'phy' || k === 'che') kGain *= (1 + s.mastery.mat / 300);
                            s.mastery[k] += kGain;
                        });
                        let sGain = 8 * (s.des.trait.mod.stress_gain || 1);
                        if (State.items.includes('i3')) sGain *= 0.8;
                        s.stress += sGain;
                    });
                    this.log("📚 指令：大规模题海战术展开。");
                } else if (id === 'hotpot') {
                    State.students.forEach(s => { s.stress = 0; s.burnout = false; s.confidence = 100; });
                    this.log("🍲 指令：全班吃火锅，士气爆棚！");
                }

                this.updateUI();
            },

            buyItem(id) {
                const item = DATA.ITEMS.find(i => i.id === id);
                let cost = item.cost;
                if (State.skills.includes('s3')) cost *= 0.7;

                if (State.money < cost) return alert("经费不足！");
                State.money -= cost;

                if (item.type === 'passive') State.items.push(id);
                else State.inventory.push(id);

                this.log(`🛒 采购：${item.n}`);
                this.updateUI();
            },

            unlockSkill(id) {
                const sk = DATA.SKILLS.find(s => s.id === id);
                if (State.prestige < sk.cost) return alert("名望不足！");
                State.prestige -= sk.cost;
                State.skills.push(id);
                this.log(`🎓 职称晋升：${sk.n}`);
                this.updateUI();
            },

            runMonthExam() {
                let details = "";
                let total = 0;
                State.students.forEach(s => {
                    let luck = (s.des.trait.mod.luck && Math.random() < s.des.trait.mod.luck) ? 40 : 0;
                    let score = Object.values(s.mastery).reduce((a, b) => a + b, 0) + luck;
                    score *= (0.9 + Math.random() * 0.2); // 考试波动
                    score = Math.round(score);
                    total += score;
                    details += `<li>${s.name}: <b>${score}</b> 分 ${luck > 0 ? '<small>(天命爆发)</small>' : ''}</li>`;
                });
                const pGain = Math.floor(total / 150);
                State.prestige += pGain;
                UI.showMsg("月度统考总结", `<ul>${details}</ul>本次考试均分：${Math.round(total / 6)}<br>获得名望：${pGain}`);
            },

            gaokao() {
                let html = "<h3>2026年夏季高考录取榜</h3><hr>";
                State.students.forEach(s => {
                    let final = Object.values(s.mastery).reduce((a, b) => a + b, 0);
                    let uni = "落榜";
                    if (final > 700) uni = "清华/北京大学 (计算机/人工智能系)";
                    else if (final > 650) uni = "上海交通大学/复旦大学";
                    else if (final > 600) uni = "重庆大学/四川大学";
                    else if (final > 530) uni = "重庆邮电大学/普通重本";
                    else if (final > 450) uni = "本科三批";
                    html += `<p>${s.name}: <b>${Math.round(final)}分</b> -> <span style="color:var(--accent)">${uni}</span></p>`;
                });
                UI.showMsg("模拟结束：盛夏的果实", html + "<br><button onclick='location.reload()'>开启平行时空</button>");
            },

            log(msg, cls = "") {
                const list = document.getElementById('log-list');
                const d = document.createElement('div');
                d.className = `log-card ${cls}`;
                d.innerHTML = `<span style="opacity:0.5; margin-right:5px;">[${State.month}/${State.week}]</span>${msg}`;
                list.appendChild(d);
            },

            updateUI() {
                document.getElementById('ui-date').innerText = `${State.year}/${State.month} W${State.week}`;
                document.getElementById('ui-money').innerText = Math.floor(State.money);
                document.getElementById('ui-ap').innerText = `${State.ap}/${State.maxAp}`;
                document.getElementById('ui-prestige').innerText = State.prestige;

                const grid = document.getElementById('classroom-grid');
                grid.innerHTML = State.students.map((s, idx) => `
            <div class="stu-card ${s.burnout ? 'sick' : ''}">
                <div class="stu-header">
                    <span class="stu-name">${s.name}</span>
                    <span style="font-size:0.7rem; opacity:0.6;">自信: ${Math.round(s.confidence)}%</span>
                </div>
                <div class="radar-box">
                    天命: ${s.des.trait.n} <br>
                    核心潜力: 逻辑(${s.des.potential.logic}) 记忆(${s.des.potential.memory})
                </div>
                <div class="sub-grid">
                    ${['chi', 'mat', 'eng', 'phy', 'che', 'bio'].map(k => `
                        <div class="sub-box">
                            <span class="sub-n">${k.toUpperCase()}</span>
                            <span class="sub-v" style="color:${UI.getVColor(s.mastery[k], (k === 'chi' || k === 'mat' || k === 'eng' ? 150 : 100))}">${Math.round(s.mastery[k])}</span>
                        </div>
                    `).join('')}
                </div>
                <div class="bar-group">
                    <div class="bar-info"><span>心理压力</span><span>${Math.round(s.stress)}%</span></div>
                    <div class="bar-outer"><div class="bar-inner" style="width:${s.stress}%; background:${s.stress > 80 ? 'var(--danger)' : 'var(--accent)'}"></div></div>
                </div>
                <button onclick="Game.doAction('chat', ${idx})" style="width:100%; padding:5px; background:transparent; border:1px solid var(--border); color:var(--text-dark); cursor:pointer; font-size:0.6rem;">单独谈心 (教师技能)</button>
            </div>
        `).join('');

                // 刷新技能和商店显示
                this.refreshShop();
            },

            refreshShop() {
                document.getElementById('item-shop').innerHTML = DATA.ITEMS.map(i => `
            <div class="item-box">
                <span style="font-size:1.2rem;">${i.id === 'i1' ? '📚' : (i.id === 'i2' ? '🥤' : '💺')}</span>
                <div style="font-size:0.8rem; font-weight:bold;">${i.n}</div>
                <div style="font-size:0.6rem; color:var(--text-dark); margin:4px 0;">${i.d}</div>
                <button onclick="Game.buyItem('${i.id}')" ${State.items.includes(i.id) ? 'disabled' : ''} style="width:100%; font-size:0.7rem; background:var(--accent); border:none; border-radius:4px; padding:3px; cursor:pointer;">
                    ${State.items.includes(i.id) ? '已生效' : '¥' + (State.skills.includes('s3') ? i.cost * 0.7 : i.cost)}
                </button>
            </div>
        `).join('');

                document.getElementById('skill-list').innerHTML = DATA.SKILLS.map(s => `
            <div class="action-card ${State.skills.includes(s.id) ? 'locked' : ''}" onclick="Game.unlockSkill('${s.id}')">
                <span class="action-cost">${State.skills.includes(s.id) ? '已解锁' : s.cost + ' 名望'}</span>
                <span class="action-title">${s.n}</span>
                <span class="action-desc">${s.d}</span>
            </div>
        `).join('');
            }
        };

        /** ================== UI 控制 ================== **/
        const UI = {
            initTemplates() {
                const teach = document.getElementById('teaching-list');
                DATA.ACTIONS.teaching.forEach(a => {
                    teach.innerHTML += `<div class="action-card" onclick="Game.doAction('${a.id}')"><span class="action-cost">AP ${a.ap} / ¥${a.money}</span><span class="action-title">${a.n}</span><span class="action-desc">${a.d}</span></div>`;
                });
                const welf = document.getElementById('welfare-list');
                DATA.ACTIONS.welfare.forEach(a => {
                    welf.innerHTML += `<div class="action-card" onclick="Game.doAction('${a.id}')"><span class="action-cost">AP ${a.ap} / ¥${a.money}</span><span class="action-title">${a.n}</span><span class="action-desc">${a.d}</span></div>`;
                });
            },
            switchTab(tab) {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.scroll-v').forEach(p => p.classList.add('hidden'));
                document.getElementById('panel-' + tab).classList.remove('hidden');
                event.currentTarget.classList.add('active');
            },
            getVColor(v, cap) {
                const r = v / cap;
                if (r > 0.9) return 'var(--danger)';
                if (r > 0.8) return 'var(--warning)';
                if (r > 0.6) return 'var(--success)';
                return 'var(--text-dark)';
            },
            showMsg(title, body) {
                document.getElementById('modal-msg').classList.remove('hidden');
                document.getElementById('msg-title').innerText = title;
                document.getElementById('msg-body').innerHTML = body;
            },
            closeModal(id) { document.getElementById(id).classList.add('hidden'); }
        };
    </script>
</body>

</html>
